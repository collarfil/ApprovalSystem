{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=approval_system;Username=postgres;Password=CHANGE_ME"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_A_RANDOM_KEY_OF_AT_LEAST_32_CHARACTERS",
    "Issuer": "ApprovalSystem",
    "Audience": "ApprovalSystemUsers",
