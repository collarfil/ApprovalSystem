  },
  "SMTP": {
    "Host": "smtp.example.com",
    "Port": 587,
    "Username": "your-smtp-username",
    "Password": "your-smtp-password-or-app-password",
    "FromEmail": "no-reply@example.com",
    "FromName": "Approval System",
    "EnableSsl": true
  }
}
